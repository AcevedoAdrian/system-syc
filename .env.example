# Copiar a `.env` para personalizar. Con `docker compose up` todos estos valores
# tienen un default, así que el archivo es opcional.

# --- Postgres (docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=syc
POSTGRES_PORT=5432

# --- API (apps/api). Dentro de docker compose, DATABASE_URL se arma con los POSTGRES_* ---
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syc
WEB_ORIGIN=http://localhost:5173

# --- Web (apps/web). Es la URL de la API vista desde el navegador ---
VITE_API_URL=http://localhost:3000
