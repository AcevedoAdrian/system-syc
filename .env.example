# Copiar a `.env` para personalizar. Con `docker compose up` todos estos valores
# tienen un default, así que el archivo es opcional.

# --- Postgres (docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=syc
POSTGRES_PORT=5432

# --- API (apps/api). Dentro de docker compose, DATABASE_URL se arma con los POSTGRES_* ---
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syc
WEB_ORIGIN=http://localhost:5173
# Better Auth. El secret debe tener al menos 32 caracteres (generar con `openssl rand -base64 32`).
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# URL pública de la API (baseURL de Better Auth)
BETTER_AUTH_URL=http://localhost:3000

# --- Seed (admin raíz + 4 departamentos). La API NO las necesita para arrancar ---
# Es manual e idempotente: `pnpm --filter @syc/api seed`
# Con Docker:               `docker compose exec api pnpm --filter @syc/api seed`
# (con `docker compose exec` hay que definir estas variables en el `.env`, o pasarlas con `-e`)
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=cambiar-esta-clave
# SEED_ADMIN_NAME=Administrador

# --- Web (apps/web) y Bruno. Es la URL de la API vista desde el cliente ---
VITE_API_URL=http://localhost:3000
