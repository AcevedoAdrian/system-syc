{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["packages/config/tsconfig.base.json", "packages/config/biome.json"],
  "tasks": {
    "generate": {
      "inputs": ["schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^generate", "generate", "^typecheck"]
    },
    "test": {
      "dependsOn": ["^generate", "generate", "^typecheck"]
    },
    "build": {
      "dependsOn": ["^generate", "generate", "^typecheck"],
      "env": ["VITE_API_URL"],
      "outputs": ["dist/**"]
    }
  }
}
