{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "extends": ["./packages/config/biome.json"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!.claude", "!.agents", "!skills", "!skills-lock.json", "!specs"]
  },
  "overrides": [
    {
      "includes": ["apps/api/**"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          }
        }
      }
    }
  ]
}
