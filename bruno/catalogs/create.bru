meta {
  name: catalogs.create
  type: http
  seq: 2
}

post {
  url: {{urlBase}}:{{port}}/catalogs/{{catalog}}
  body: json
  auth: inherit
}

body:json {
  {
    "nombre": "Ítem de prueba",
    "tipoId": "{{areaTipoId}}",
    "departamentoIds": ["{{moduloDepartamentoId}}"]
  }
}

assert {
  res.status: eq 200
  res.body.id: isString
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("catalogItemId", res.body.id);
    // Un tipo de área recién creado es el que usan las altas de áreas (`tipoId`).
    if (bru.getEnvVar("catalog") === "tiposArea") bru.setVar("areaTipoId", res.body.id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Crea un ítem. Solo admin (permiso `manage`).

  Contrato: `catalogs.<catálogo>.create` en `packages/contracts`.
  Método: POST
  Ruta: /catalogs/{catálogo}
  Cuerpo: nombre (1 a 120 caracteres). Proveedores suma contacto, telefono, correo y sitioWeb,
  todos opcionales; en blanco se guardan como null. Áreas suma `tipoId` (obligatorio): el id de un
  tipo de área activo. Módulos suma `departamentoIds` (obligatorio, al menos uno): ids de
  departamentos activos, que se toman de la variable `moduloDepartamentoId` (el id de un departamento,
  de `organizations.list`); los demás catálogos ignoran esos dos campos.

  El ítem nace activo y al final del orden. Guarda el id en `catalogItemId`.
  Errores: 400 validación (en áreas, también un `tipoId` que no existe o está desactivado; en módulos,
  sin departamentos o con uno que no existe o está desactivado); 403 si no es admin;
  409 si el nombre ya existe en ese catálogo (en áreas, dentro del mismo tipo).
}
