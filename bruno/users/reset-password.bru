meta {
  name: users.resetPassword
  type: http
  seq: 6
}

post {
  url: {{urlBase}}:{{port}}/users/:userId/reset-password
  body: json
  auth: inherit
}

params:path {
  userId: {{userId}}
}

body:json {
  {
    "password": "nueva-clave-de-prueba-123"
  }
}

assert {
  res.status: eq 200
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Resetea la contraseña de un usuario. Solo admin (permiso `manage`).

  Contrato: `users.resetPassword` en `packages/contracts`.
  Método: POST
  Ruta: /users/{userId}/reset-password
  Cuerpo: password (8 a 128 caracteres).

  Cierra todas las sesiones del usuario. No devuelve cuerpo.
  Errores: 400 validación; 404 usuario inexistente.
}
