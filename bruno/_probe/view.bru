meta {
  name: probe.view
  type: http
  seq: 1
}

get {
  url: {{urlBase}}:{{port}}/_probe/departments/:departmentId
  body: none
  auth: inherit
}

params:path {
  departmentId: {{organizationId}}
}

assert {
  res.status: eq 200
  res.body.ok: eq true
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  TEMPORAL (SPEC 02): prueba del portero de permisos. SPEC 05 lo reemplaza por tickets reales.

  Método: GET
  Ruta: /_probe/departments/{departmentId}
  Permiso: `ticket:view` (Lectura) sobre el departamento de la URL.

  No tiene contrato en `packages/contracts`; vive en `modules/permissions-probe`.
  `departmentId` sale de `organizationId` (corré `organizations.list` antes).

  Respuesta 200: { ok: true, scope } donde scope es el departamento del agente o `null` para un admin.
  Un agente pide un departamento ajeno: 403. Sin sesión: 401.
}
