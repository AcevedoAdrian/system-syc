  orden             Int // lo asigna el service (máximo + 1 en el alta); solo cambia con `move`
  activo            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String
  creador           User      @relation("ProveedorCreador", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy         String
  editor            User      @relation("ProveedorEditor", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt         DateTime?
  contacto          String?
  telefono          String?
  correo            String?
  sitioWeb          String?

  @@map("proveedor")
}

model EstadoTicket {
  id                String    @id @default(cuid())
  nombre            String
  nombreNormalizado String // normalizeName(nombre): lo calcula el service, nunca llega del cliente
  orden             Int // lo asigna el service (máximo + 1 en el alta); solo cambia con `move`
  activo            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String
  creador           User      @relation("EstadoTicketCreador", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy         String
  editor            User      @relation("EstadoTicketEditor", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt         DateTime?
  // Clave interna de los estados de sistema (D1): "FINALIZADO" | "CERRADO" | "CANCELADO" | "REABIERTO" | null.
  clave             String?

  @@unique([clave]) // Postgres no compara los NULL entre sí: solo restringe las 4 claves
  @@map("estado_ticket")
}
