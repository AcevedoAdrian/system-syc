  nombre            String
  nombreNormalizado String // normalizeName(nombre): lo calcula el service, nunca llega del cliente
  orden             Int // lo asigna el service (máximo + 1 en el alta); solo cambia con `move`
  activo            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String
  creador           User      @relation("TipoTicketCreador", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy         String
  editor            User      @relation("TipoTicketEditor", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt         DateTime?
  tickets           Ticket[]

  @@map("tipo_ticket")
}

model Prioridad {
  id                String    @id @default(cuid())
  nombre            String
  nombreNormalizado String // normalizeName(nombre): lo calcula el service, nunca llega del cliente
  orden             Int // lo asigna el service (máximo + 1 en el alta); solo cambia con `move`
  activo            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String
  creador           User      @relation("PrioridadCreador", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy         String
  editor            User      @relation("PrioridadEditor", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt         DateTime?
  tickets           Ticket[]

  @@map("prioridad")
}

model Modulo {
  id                String    @id @default(cuid())
  nombre            String
  nombreNormalizado String // normalizeName(nombre): lo calcula el service, nunca llega del cliente
  orden             Int // lo asigna el service (máximo + 1 en el alta); solo cambia con `move`
  activo            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String
  creador           User      @relation("ModuloCreador", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy         String
  editor            User      @relation("ModuloEditor", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt         DateTime?
  tickets           Ticket[]

  @@map("modulo")
}

model Proveedor {
  id                String    @id @default(cuid())
  nombre            String
  nombreNormalizado String // normalizeName(nombre): lo calcula el service, nunca llega del cliente
  orden             Int // lo asigna el service (máximo + 1 en el alta); solo cambia con `move`
  activo            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String
  creador           User      @relation("ProveedorCreador", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy         String
  editor            User      @relation("ProveedorEditor", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt         DateTime?
  contacto          String?
  telefono          String?
  correo            String?
  sitioWeb          String?
  tickets           Ticket[]

  @@map("proveedor")
}

model EstadoTicket {
  id                String    @id @default(cuid())
  nombre            String
  nombreNormalizado String // normalizeName(nombre): lo calcula el service, nunca llega del cliente
  orden             Int // lo asigna el service (máximo + 1 en el alta); solo cambia con `move`
  activo            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String
  creador           User      @relation("EstadoTicketCreador", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy         String
  editor            User      @relation("EstadoTicketEditor", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt         DateTime?
  // Clave interna de los estados de sistema (D1): "FINALIZADO" | "CERRADO" | "CANCELADO" | "REABIERTO" | null.
  clave             String?
  tickets           Ticket[]

  @@unique([clave]) // Postgres no compara los NULL entre sí: solo restringe las 4 claves
  @@map("estado_ticket")
}

// Ticket (SPEC 05). `numero` sale de la secuencia nativa `ticket_numero_seq` (el autoincrement de una
// columna que no es `@id` crea una secuencia en Postgres): nunca se repite entre transacciones
// concurrentes y un alta fallida deja un hueco, que se tolera (Q21). `updatedAt` es también la versión
// del bloqueo optimista. El índice único parcial de `referenciaExterna` vive en el SQL de la migración
// `tickets` (Prisma no lo expresa).
model Ticket {
  id     String @id @default(cuid())
  numero Int    @unique @default(autoincrement())

  departamentoId String
  departamento   Organization @relation(fields: [departamentoId], references: [id], onDelete: Restrict)
  areaId         String?
  area           Area?        @relation(fields: [areaId], references: [id], onDelete: Restrict)
  edificioId     String?
  edificio       Edificio?    @relation(fields: [edificioId], references: [id], onDelete: Restrict)
  tipoId         String?
  tipo           TipoTicket?  @relation(fields: [tipoId], references: [id], onDelete: Restrict)
  prioridadId    String
  prioridad      Prioridad    @relation(fields: [prioridadId], references: [id], onDelete: Restrict)
  moduloId       String?
  modulo         Modulo?      @relation(fields: [moduloId], references: [id], onDelete: Restrict)
  estadoId       String
  estado         EstadoTicket @relation(fields: [estadoId], references: [id], onDelete: Restrict)
  proveedorId    String?
  proveedor      Proveedor?   @relation(fields: [proveedorId], references: [id], onDelete: Restrict)

  titulo              String
  descripcion         String?
  actuacionSimple     String?
  referenciaExterna   String? // "número/año" ya normalizado; único por proveedor (índice parcial)
  solucionDescripcion String?
  notificado          Boolean @default(false)

  fechaRecepcion DateTime  @db.Date
  fechaCierre    DateTime? @db.Date
  fechaReabierto DateTime? @db.Date

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  creador   User      @relation("TicketCreador", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy String
  editor    User      @relation("TicketEditor", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt DateTime?

  comentarios TicketComentario[]

  @@index([departamentoId])
  @@map("ticket")
}

model TicketComentario {
  id        String    @id @default(cuid())
  ticketId  String
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  texto     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt // solo cambia al eliminarlo: no hay edición
  createdBy String
  autor     User      @relation("TicketComentarioAutor", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedBy String
  editor    User      @relation("TicketComentarioEditor", fields: [updatedBy], references: [id], onDelete: Restrict)
  deletedAt DateTime?

  @@index([ticketId, createdAt])
  @@map("ticket_comentario")
}
