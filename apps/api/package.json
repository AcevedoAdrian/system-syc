    "build": "tsdown",
    "start": "node dist/main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@orpc/contract": "1.15.4",
    "@orpc/nest": "1.15.4",
    "@orpc/server": "1.15.4",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@syc/config": "workspace:*",
    "@syc/contracts": "workspace:*",
    "@syc/db": "workspace:*",
    "tsdown": "0.23.0",
    "vitest": "5.0.1"
