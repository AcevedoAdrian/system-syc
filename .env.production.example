# Producción (SPEC 07). Se copia como `.env` en la raíz del repo, en el servidor:
#   cp .env.production.example .env
# Procedimiento completo en `docs/despliegue.md`. No uses este archivo en desarrollo: ahí vale `.env.example`.

# --- Obligatorias: sin ellas `docker compose` no arranca y nombra la que falta ---

# La URL por la que entran todos, tal cual la escriben en el navegador (con el puerto si no es el 80).
# Better Auth rechaza el login desde cualquier otro origen: entrar por un nombre de host distinto
# del escrito acá falla. Sin HTTPS ni dominio (SPEC 07, Q37).
PUBLIC_URL=http://10.0.0.5

# Usá solo letras y números (por ejemplo `openssl rand -hex 24`): va dentro de la URL de la base,
# y un `@`, `/` o `:` la rompe.
POSTGRES_PASSWORD=

# Mínimo 32 caracteres: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# --- Opcionales (valen estos valores si no están) ---
POSTGRES_USER=postgres
POSTGRES_DB=syc
# Puerto del servidor donde escucha Nginx. Si no es el 80, ponelo también en PUBLIC_URL.
HTTP_PORT=80
# Carpeta del servidor donde quedan las copias. Crearla antes del primer `up`.
BACKUP_DIR=/srv/syc/backups

# --- Solo para el seed del primer deploy: borrá estas cuatro líneas del `.env` después ---
# (admin raíz, departamentos, catálogos iniciales y agentes; ver `docs/despliegue.md`)
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
# Contraseña temporal de los agentes del seed; sin ella no se cargan. Cada uno la cambia al entrar.
SEED_AGENTS_PASSWORD=
